# ==============================================================================
# LegalEase – Intelligent Contract Review & Risk Assessment System
# Environment Configuration Template
# ==============================================================================

# Database (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=legalease
DB_USER=root
DB_PASSWORD=rootpassword

# Redis Cache & Sliding Window Rate Limiter
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security Keys
# HS512 JWT Secret (must be 64+ characters / 512 bits in Base64 or plain string)
JWT_SECRET=c2VjdXJlX2xlZ2FsZWFzZV9qd3Rfc2VjcmV0X2tleV93aXRoX2F0X2xlYXN0XzUxMl9iaXRzX2Zvcl9ocy01MTJfc2lnbmluZ19hbGdvcml0aG1fcHJvZHVjdGlvbg==
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Cryptographic AES-256 Key (Hex-encoded 32 bytes = 64 hex characters)
ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Anthropic Claude 3.5 Sonnet API Key (Optional: System operates in Deterministic Fallback mode if omitted)
ANTHROPIC_API_KEY=

# Mail Server Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Twilio SMS / WhatsApp OTP (Optional mock fallback available)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# File Storage Directories (Relative or Absolute)
UPLOAD_DIR=./uploads
VERIFICATION_DIR=./verification-docs
APPEAL_DIR=./appeal-docs

# Client URLs & CORS Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
